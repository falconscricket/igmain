{
  "name": "ig-ai-image-bot",
  "version": "1.0.0",
  "description": "Automatically generates AI images every 2 hours and posts them to Instagram using the Pollinations AI API and the Instagram Graph API.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "post-now": "node -e \"import('./scheduler.js').then(m => m.runTask())\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.44",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "license": "MIT",
  "author": "",
  "keywords": [
    "instagram",
    "ai",
    "automation",
    "pollinations",
    "graph-api",
    "cron"
  ]
}
