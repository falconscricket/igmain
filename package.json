{
  "name": "ig-anime-quiz-bot",
  "version": "2.0.0",
  "description": "Auto posts anime quiz cards to Instagram every 30 mins",
  "type": "module",
  "main": "index.js",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "post-now": "node -e \"import('./scheduler.js').then(m => m.runTask())\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.44",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  },
  "license": "MIT"
}
