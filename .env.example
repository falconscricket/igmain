# ── Instagram ────────────────────────────────────────────────────
IG_ACCESS_TOKEN=your_long_lived_page_token_here
IG_USER_ID=your_instagram_business_account_id

# ── App ──────────────────────────────────────────────────────────
PORT=3000
PUBLIC_BASE_URL=https://your-app.up.railway.app

# ── Schedule ─────────────────────────────────────────────────────
# Every 30 mins = 48 posts/day (safe limit)
CRON_SCHEDULE=*/30 * * * *
RUN_ON_STARTUP=false

# ── Card design ──────────────────────────────────────────────────
WATERMARK_TEXT=alpha@developer

# ── Railway Volume (for posted log persistence) ──────────────────
POSTED_LOG_PATH=/app/data/posted-quotes.json
